{
  "name": "root",
  "version": "1.8.2",
  "engines": {
    "node": "^18.13.0 || ^20.9.0 || >22.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve dev-app",
    "start:module": "ng serve dev-module-app",
    "build": "npm run build:lib && npm run build:schematics && npm run build:dev-app && npm run build:dev-module-app",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "changelog:all": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "test": "ng test",
    "lint": "ng lint angular-toaster && ng lint dev-app",
    "lint:fix": "ng lint angular-toaster --fix && ng lint dev-app --fix",
    "e2e": "ng e2e",
    "build:dev-app": "ng build dev-app",
    "build:dev-module-app": "ng build dev-module-app",
    "build:lib": "ng build angular-toaster --configuration production",
    "build:schematics": "tsc -p ./packages/angular-toaster/schematics/tsconfig.json --outDir dist/angular-toaster/schematics",
    "copyfile:schema": "copyfiles -f ./packages/angular-toaster/schematics/ng-add/schema.json ./dist/angular-toaster/schematics/ng-add",
    "copyfile:collection": "copyfiles -f ./packages/angular-toaster/schematics/collection.json ./dist/angular-toaster/schematics",
    "copyfile": "npm run copyfile:schema && npm run copyfile:collection",
    "test:schematics": "ts-node --project packages/angular-toaster/schematics/tsconfig.spec.json node_modules/jasmine/bin/jasmine.js packages/angular-toaster/schematics/**/*.spec.ts",
    "test:lib": "ng test angular-toaster",
    "test:lib:ci": "ng test angular-toaster  --browsers=ChromeHeadless --watch=false --code-coverage && cat ./coverage/angular-toaster/lcov.info | ./node_modules/coveralls/bin/coveralls.js",
    "clean": "rimraf dist",
    "sass": "sass packages/angular-toaster/src/toaster.scss dist/angular-toaster/toaster.css",
    "uglifycss": "esbuild --bundle dist/angular-toaster/toaster.css --outfile=dist/angular-toaster/toaster.min.css --minify  --sourcemap=external",
    "copy": "cpx LICENSE dist/angular-toaster && cpx packages/angular-toaster/README.md dist/angular-toaster && npm run copystyles",
    "copystyles": "cpx \"packages/angular-toaster/src/lib/*.{css,css.map,min.css,scss}\" dist/angular-toaster",
    "package": "npm run clean && npm run build:lib && npm run sass && npm run uglifycss && npm run copy && npm run build:schematics",
    "prerelease": "npm run clean && npm run build:lib && npm run sass && npm run uglifycss && npm run copy && npm run build:dev-app",
    "release": "tsx scripts/release.ts",
    "release:alpha": "tsx scripts/release.ts --preId alpha",
    "release:beta": "tsx scripts/release.ts --preId beta",
    "prepare": "husky || true",
    "serve:ssr:dev-module-app": "node dist/dev-module-app/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular-devkit/schematics": "^20.0.2",
    "@angular/animations": "^20.0.3",
    "@angular/common": "^20.0.3",
    "@angular/compiler": "^20.0.3",
    "@angular/core": "^20.0.3",
    "@angular/forms": "^20.0.3",
    "@angular/localize": "^20.0.3",
    "@angular/platform-browser": "^20.0.3",
    "@angular/platform-browser-dynamic": "^20.0.3",
    "@angular/platform-server": "^20.0.3",
    "@angular/router": "^20.0.3",
    "@angular/ssr": "^20.0.2",
    "bootstrap": "^5.3.2",
    "express": "^4.18.2",
    "highlight.js": "^11.11.1",
    "marked": "^15.0.12",
    "marked-highlight": "^2.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.2",
    "@angular/cli": "^20.0.2",
    "@angular/compiler-cli": "^20.0.3",
    "@changesets/cli": "^2.24.0",
    "@schematics/angular": "^20.0.2",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.15.29",
    "@types/shelljs": "^0.8.16",
    "angular-cli-ghpages": "^2.0.3",
    "angular-eslint": "20.0.0",
    "colors": "^1.4.0",
    "conventional-changelog-cli": "^2.2.2",
    "copyfiles": "^2.4.1",
    "coveralls": "3.1.0",
    "cpx": "^1.5.0",
    "enquirer": "^2.3.6",
    "esbuild": "0.14.22",
    "eslint": "^9.28.0",
    "fs-extra": "^10.1.0",
    "husky": "^9.0.10",
    "jasmine": "~5.1.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "minimist": "^1.2.6",
    "ng-packagr": "^20.0.0",
    "rimraf": "^3.0.2",
    "sass": "^1.70.0",
    "semver": "^7.3.7",
    "shelljs": "^0.8.5",
    "ts-node": "10.7.0",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.33.1"
  }
}
